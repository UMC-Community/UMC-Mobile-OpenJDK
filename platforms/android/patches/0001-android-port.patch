diff --git a/src/java.desktop/android/native/libjsound/PLATFORM_API_AndroidOS_AAudio_PCM.c b/src/java.desktop/android/native/libjsound/PLATFORM_API_AndroidOS_AAudio_PCM.c
new file mode 100644
index 000000000..142e9932b
--- /dev/null
+++ b/src/java.desktop/android/native/libjsound/PLATFORM_API_AndroidOS_AAudio_PCM.c
@@ -0,0 +1,244 @@
+/*
+ * UMC: javax.sound DirectAudio backend for Android using AAudio.
+ *
+ * Output-only implementation: one mixer, one playback device (16-bit PCM,
+ * mono/stereo, 44.1/48 kHz). Capture, ports and MIDI are disabled at build
+ * time (USE_PORTS=FALSE, USE_PLATFORM_MIDI_*=FALSE).
+ */
+#include "DirectAudio.h"
+#include "SoundDefs.h"
+#include "Utilities.h"
+
+#include <aaudio/AAudio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdio.h>
+
+#define AAUDIO_TIMEOUT_NS (1000LL * 1000LL * 1000LL) /* 1s */
+
+typedef struct {
+    AAudioStream *stream;
+    int isSource;
+    int frameSize;
+    int bufferSizeBytes;
+    INT64 writtenBytes;
+    int started;
+} AndroidAudioHandle;
+
+static void set_string(char *dst, size_t len, const char *src) {
+    if (len == 0) {
+        return;
+    }
+    strncpy(dst, src, len - 1);
+    dst[len - 1] = '\0';
+}
+
+INT32 DAUDIO_GetDirectAudioDeviceCount(void) {
+    return 1;
+}
+
+INT32 DAUDIO_GetDirectAudioDeviceDescription(INT32 mixerIndex,
+                                             DirectAudioDeviceDescription *description) {
+    if (mixerIndex != 0 || description == NULL) {
+        return FALSE;
+    }
+    description->deviceID = 0;
+    description->maxSimulLines = 8;
+    set_string(description->name, sizeof(description->name), "Android AAudio");
+    set_string(description->vendor, sizeof(description->vendor), "UMC");
+    set_string(description->description, sizeof(description->description),
+               "Android AAudio playback");
+    set_string(description->version, sizeof(description->version), "1.0");
+    return TRUE;
+}
+
+void DAUDIO_GetFormats(INT32 mixerIndex, INT32 deviceID, int isSource, void *creator) {
+    if (mixerIndex != 0 || deviceID != 0 || !isSource) {
+        return;
+    }
+    /* 16-bit signed little-endian PCM */
+    DAUDIO_AddAudioFormat(creator, 16, 4, 2, 44100.0f, DAUDIO_PCM, TRUE, FALSE);
+    DAUDIO_AddAudioFormat(creator, 16, 4, 2, 48000.0f, DAUDIO_PCM, TRUE, FALSE);
+    DAUDIO_AddAudioFormat(creator, 16, 2, 1, 44100.0f, DAUDIO_PCM, TRUE, FALSE);
+    DAUDIO_AddAudioFormat(creator, 16, 2, 1, 48000.0f, DAUDIO_PCM, TRUE, FALSE);
+}
+
+void *DAUDIO_Open(INT32 mixerIndex, INT32 deviceID, int isSource,
+                  int encoding, float sampleRate, int sampleSizeInBits,
+                  int frameSize, int channels,
+                  int isSigned, int isBigEndian, int bufferSizeInBytes) {
+    if (mixerIndex != 0 || deviceID != 0 || !isSource) {
+        return NULL;
+    }
+    if (encoding != DAUDIO_PCM || !isSigned || isBigEndian ||
+        sampleSizeInBits != 16 || channels <= 0 || frameSize <= 0) {
+        return NULL;
+    }
+
+    AAudioStreamBuilder *builder = NULL;
+    if (AAudio_createStreamBuilder(&builder) != AAUDIO_OK || builder == NULL) {
+        return NULL;
+    }
+    AAudioStreamBuilder_setDirection(builder, AAUDIO_DIRECTION_OUTPUT);
+    AAudioStreamBuilder_setFormat(builder, AAUDIO_FORMAT_PCM_I16);
+    AAudioStreamBuilder_setSampleRate(builder, (int32_t) sampleRate);
+    AAudioStreamBuilder_setChannelCount(builder, channels);
+    AAudioStreamBuilder_setPerformanceMode(builder, AAUDIO_PERFORMANCE_MODE_NONE);
+    AAudioStreamBuilder_setSharingMode(builder, AAUDIO_SHARING_MODE_SHARED);
+    if (bufferSizeInBytes > 0) {
+        int32_t frames = bufferSizeInBytes / frameSize;
+        if (frames > 0) {
+            AAudioStreamBuilder_setBufferCapacityInFrames(builder, frames);
+        }
+    }
+
+    AAudioStream *stream = NULL;
+    aaudio_result_t res = AAudioStreamBuilder_openStream(builder, &stream);
+    AAudioStreamBuilder_delete(builder);
+    if (res != AAUDIO_OK || stream == NULL) {
+        return NULL;
+    }
+
+    AndroidAudioHandle *h = (AndroidAudioHandle *) calloc(1, sizeof(AndroidAudioHandle));
+    if (h == NULL) {
+        AAudioStream_close(stream);
+        return NULL;
+    }
+    h->stream = stream;
+    h->isSource = isSource;
+    h->frameSize = frameSize;
+
+    int32_t bufFrames = AAudioStream_getBufferSizeInFrames(stream);
+    if (bufFrames <= 0) {
+        bufFrames = (int32_t) (sampleRate / 10.0f); /* ~100 ms fallback */
+    }
+    h->bufferSizeBytes = (int) bufFrames * frameSize;
+
+    return h;
+}
+
+int DAUDIO_Start(void *id, int isSource) {
+    AndroidAudioHandle *h = (AndroidAudioHandle *) id;
+    if (h == NULL || !h->isSource) {
+        return FALSE;
+    }
+    aaudio_result_t res = AAudioStream_requestStart(h->stream);
+    if (res != AAUDIO_OK) {
+        return FALSE;
+    }
+    h->started = 1;
+    return TRUE;
+}
+
+int DAUDIO_Stop(void *id, int isSource) {
+    AndroidAudioHandle *h = (AndroidAudioHandle *) id;
+    if (h == NULL || !h->isSource) {
+        return FALSE;
+    }
+    AAudioStream_requestStop(h->stream);
+    aaudio_stream_state_t state = AAudioStream_getState(h->stream);
+    while (state != AAUDIO_STREAM_STATE_STOPPED && state != AAUDIO_STREAM_STATE_CLOSED) {
+        aaudio_stream_state_t next = AAUDIO_STREAM_STATE_UNINITIALIZED;
+        if (AAudioStream_waitForStateChange(h->stream, state, &next, AAUDIO_TIMEOUT_NS) != AAUDIO_OK) {
+            break;
+        }
+        state = next;
+    }
+    h->started = 0;
+    return TRUE;
+}
+
+void DAUDIO_Close(void *id, int isSource) {
+    AndroidAudioHandle *h = (AndroidAudioHandle *) id;
+    if (h == NULL) {
+        return;
+    }
+    if (h->started) {
+        DAUDIO_Stop(id, isSource);
+    }
+    AAudioStream_close(h->stream);
+    free(h);
+}
+
+int DAUDIO_Write(void *id, char *data, int byteSize) {
+    AndroidAudioHandle *h = (AndroidAudioHandle *) id;
+    if (h == NULL || !h->isSource || data == NULL || byteSize <= 0) {
+        return -1;
+    }
+    int totalFrames = byteSize / h->frameSize;
+    int done = 0;
+    while (done < totalFrames) {
+        int32_t written = AAudioStream_write(h->stream, data + (size_t) done * h->frameSize,
+                                             totalFrames - done, AAUDIO_TIMEOUT_NS);
+        if (written < 0) {
+            return -1;
+        }
+        if (written == 0) {
+            continue;
+        }
+        done += written;
+    }
+    h->writtenBytes += (INT64) totalFrames * h->frameSize;
+    return byteSize;
+}
+
+int DAUDIO_Read(void *id, char *data, int byteSize) {
+    (void) id;
+    (void) data;
+    (void) byteSize;
+    return -1;
+}
+
+int DAUDIO_GetBufferSize(void *id, int isSource) {
+    AndroidAudioHandle *h = (AndroidAudioHandle *) id;
+    if (h == NULL || !h->isSource) {
+        return 0;
+    }
+    return h->bufferSizeBytes;
+}
+
+int DAUDIO_StillDraining(void *id, int isSource) {
+    (void) id;
+    (void) isSource;
+    return FALSE;
+}
+
+int DAUDIO_Flush(void *id, int isSource) {
+    (void) id;
+    (void) isSource;
+    return TRUE;
+}
+
+int DAUDIO_GetAvailable(void *id, int isSource) {
+    AndroidAudioHandle *h = (AndroidAudioHandle *) id;
+    if (h == NULL || !h->isSource) {
+        return 0;
+    }
+    return h->bufferSizeBytes;
+}
+
+INT64 DAUDIO_GetBytePosition(void *id, int isSource, INT64 javaBytePos) {
+    AndroidAudioHandle *h = (AndroidAudioHandle *) id;
+    if (h == NULL) {
+        return javaBytePos;
+    }
+    return javaBytePos + h->writtenBytes;
+}
+
+void DAUDIO_SetBytePosition(void *id, int isSource, INT64 javaBytePos) {
+    AndroidAudioHandle *h = (AndroidAudioHandle *) id;
+    if (h != NULL) {
+        h->writtenBytes = javaBytePos;
+    }
+}
+
+int DAUDIO_RequiresServicing(void *id, int isSource) {
+    (void) id;
+    (void) isSource;
+    return FALSE;
+}
+
+void DAUDIO_Service(void *id, int isSource) {
+    (void) id;
+    (void) isSource;
+}
